# Copy to .env and replace examples. Do not commit .env or secret files.
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_NOTIFY_USER_IDS=123456789
DSM_BASE_URL=https://nas.example.internal:5001
DSM_USERNAME=synobot
DSM_TLS_VERIFY=true
DSM_REQUEST_TIMEOUT_SECONDS=20
DSM_POLL_INTERVAL_SECONDS=10
DSM_DESTINATION_PRESETS=TVShows,Movies,Download
DATABASE_PATH=/data/synobot.db
DSM_AUTO_DELETE=false
TELEGRAM_LANGUAGE=en
TZ=Asia/Kuwait

# Prefer mounted secret files configured in compose.yaml:
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# DSM_PASSWORD_FILE=/run/secrets/dsm_password
# DSM_TOTP_SECRET_FILE=/run/secrets/dsm_totp_secret

# Optional mounted Download Station watch directory:
# DSM_TORRENT_WATCH_PATH=/downloads/watch

# Compatibility-only interactive password recipient:
# TELEGRAM_DSM_PASSWORD_USER_ID=123456789
